# Copy to .env before deployment. Never commit the copied .env file.
POSTGRES_DB=merchant_assistant
POSTGRES_USER=merchant
POSTGRES_PASSWORD=change-this-password

# Optional: leave blank to use the built-in rules analysis.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4.1-mini
